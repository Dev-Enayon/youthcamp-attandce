{
  "name": "youthcamp-attendance",
  "version": "1.0.0",
  "private": true,
  "description": "Gospel Of Truth Mission (Lagos Ogun Badagry Branch) Youth Camp Programme Registration System",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
