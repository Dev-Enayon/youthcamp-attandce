# ---------------------------------------------------------------------------
# Gospel Of Truth Mission — Youth Camp Registration System
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Primary database (production = Neon, local dev = local PostgreSQL) ------
# Neon API runtime: use the POOLED connection string from the Neon console
# (hostname ends in `-pooler...neon.tech`), usually with `sslmode=require`.
# Local dev: postgresql://USER@127.0.0.1:5432/youthcamp?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST_DB_POOLED?sslmode=require"

# --- Direct connection string, REQUIRED for `prisma migrate deploy` ----------
# Neon: the NON-POOLED "Direct connection string" from the Neon console
# (hostname has NO `-pooler`). Migrations must not run through the pooler.
# Do not derive this from DATABASE_URL — copy the exact direct string.
# Local dev: same as DATABASE_URL above.
# Leave unset until the exact direct string is available (Prisma then uses
# DATABASE_URL as a fallback for migrations).
DIRECT_URL="postgresql://USER:PASSWORD@HOST_DB_DIRECT?sslmode=require"

# --- Isolated test database --------------------------------------------------
# Used ONLY by the automated test suite (npm test / npm run test:watch).
# MUST be a dedicated database, never the production one. The test suite
# refuses to run if this value looks like a production URL.
TEST_DATABASE_URL="postgresql://USER@127.0.0.1:5432/youthcamp_test?schema=public"

# --- Auth --------------------------------------------------------------------
# Secret used to sign admin sessions and confirmation tokens. Generate with:
#   openssl rand -base64 48
# At least 32 characters.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# --- Initial administrator (USED ONLY BY `npm run prisma:seed`) --------------
# The seed script hashes ADMIN_PASSWORD (Argon2id) before storing it.
# Never reuse the local development value in production; rotate after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Camp Administrator"
ADMIN_PASSWORD="replace-with-a-strong-password"

# --- Public base URL of the deployed application (no trailing slash) ---------
APP_URL="http://localhost:3000"